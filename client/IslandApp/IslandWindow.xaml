<?xml version="1.0" encoding="utf-8"?>
<!-- 灵动岛壳窗口：布局规格取自 docs/02-灵动岛设计.md v1.0
     胶囊态 216×36（时间·正在播放·未读角标）↔ 展开态 1280×480（44px 页签栏 + 页面区） -->
<Window
    x:Class="IslandApp.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased">

        <!-- ================= 胶囊态（216×36） ================= -->
        <Grid x:Name="CapsulePanel" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 时间（1 秒刷新；胶囊点击整窗展开、按住拖动换位） -->
            <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00"
                       FontSize="15" FontWeight="SemiBold"
                       Margin="14,0,10,0" VerticalAlignment="Center"/>
            <!-- 正在播放：SMTC 接入后填充歌名（跑马灯 P1） -->
            <TextBlock x:Name="TrackText" Grid.Column="1" Text="未在播放"
                       FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <FontIcon Grid.Column="2" Glyph="&#xE8D6;" FontSize="13" Opacity="0.65"
                      Margin="8,0,0,0" VerticalAlignment="Center"/>
            <!-- 未读角标：审批+消息合并计数，WS 接入后显示 -->
            <Border x:Name="Badge" Grid.Column="3" CornerRadius="8" Background="#E5484D"
                    MinWidth="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Text="0" FontSize="10" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ================= 展开态（1280×480） ================= -->
        <Grid x:Name="ExpandedPanel" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 44px 页签栏：左 4 页签，右 [—] 收起 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button x:Name="Tab0" Tag="0" Content="🕘 工作台" Click="OnTabClick"
                            Background="Transparent" CornerRadius="6" Padding="14,6"
                            FontSize="13" Margin="0,0,4,0"/>
                    <Button x:Name="Tab1" Tag="1" Content="📁 文件" Click="OnTabClick"
                            Background="Transparent" CornerRadius="6" Padding="14,6"
                            FontSize="13" Margin="0,0,4,0"/>
                    <Button x:Name="Tab2" Tag="2" Content="💬 对话" Click="OnTabClick"
                            Background="Transparent" CornerRadius="6" Padding="14,6"
                            FontSize="13" Margin="0,0,4,0"/>
                    <Button x:Name="Tab3" Tag="3" Content="👤 我" Click="OnTabClick"
                            Background="Transparent" CornerRadius="6" Padding="14,6"
                            FontSize="13"/>
                </StackPanel>
                <Button x:Name="CollapseBtn" Content="—"
                        Click="OnCollapseClick" ToolTipService.ToolTip="收起（Esc）"
                        Background="Transparent" CornerRadius="6" Padding="10,4"
                        HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 内容宿主：展开时 Composition scale 0.92→1 + 淡入 -->
            <Grid x:Name="ContentHost" Grid.Row="1">

                <!-- P1 工作台（小组件仪表盘，默认页） -->
                <StackPanel x:Name="Page0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE80F;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="工作台" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="小组件仪表盘 · 天气/待办/照片/音乐/启动器/审批" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock Text="（服务接入后填充）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- P2 文件页（左公共 45% / 右个人 55%） -->
                <StackPanel x:Name="Page1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="文件" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="左公共（群选择）/ 右个人 · 上传下载收藏" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock Text="（服务接入后填充）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- P3 对话页（左列表 260px / 右会话） -->
                <StackPanel x:Name="Page2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="对话" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="单聊+群聊 · WS 实时推送" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock Text="（服务接入后填充）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- P4 个人中心（左资料 / 右设置） -->
                <StackPanel x:Name="Page3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="个人中心" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="资料/头像/密码 + 设置中心" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock Text="（登录卡在无 token 时强制展示，服务接入后实现）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
