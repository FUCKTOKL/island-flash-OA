<?xml version="1.0" encoding="utf-8"?>
<!-- 灵动岛壳窗口：布局规格取自 docs/02-灵动岛设计.md v1.0
     胶囊态 216×36（时间·正在播放·未读角标）↔ 展开态 1280×480（44px 页签栏 + 页面区） -->
<Window
    x:Class="IslandApp.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RequestedTheme="Dark" Background="#FF131519"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased">

        <!-- 刘海框：XAML 圆角(20) 小于区域裁剪(24) → 深色渐变溢出裁剪边，
             杜绝亚克力缝隙漏出的白边；窗口整体 RequestedTheme=Dark（黑底白字） -->
        <Border x:Name="IslandFrame" CornerRadius="0,0,20,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF131519" Offset="0"/>
                    <GradientStop Color="#FF1D2127" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>

        <!-- ================= 胶囊态（216×36） ================= -->
        <!-- 胶囊态：极简把手（拍板：收起只留“-”）；未读时叠红点 -->
        <Grid x:Name="CapsulePanel" Height="36">
            <Border Width="36" Height="4" CornerRadius="2" Background="#99FFFFFF"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="Badge" CornerRadius="8" Background="#E5484D"
                    MinWidth="16" Height="16" Margin="14,2,0,0" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Text="0" FontSize="10" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ================= 展开态（1280×480） ================= -->
        <Grid x:Name="ExpandedPanel" Visibility="Collapsed" IsHitTestVisible="False" Padding="16,10,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 页签岛：悬浮毛玻璃胶囊（Apple 风：组件即岛） -->
            <Border Grid.Row="0" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                    Background="#B322252C" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Tab0" Tag="0" Click="OnTabClick" Background="Transparent"
                            CornerRadius="6" Padding="12,6" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                            <TextBlock Text="工作台" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Tab1" Tag="1" Click="OnTabClick" Background="Transparent"
                            CornerRadius="6" Padding="12,6" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="文件" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Tab2" Tag="2" Click="OnTabClick" Background="Transparent"
                            CornerRadius="6" Padding="12,6" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14"/>
                            <TextBlock Text="对话" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Tab3" Tag="3" Click="OnTabClick" Background="Transparent"
                            CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                            <TextBlock Text="我" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 收起：独立小圆岛 -->
            <Border Grid.Row="0" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Background="#B322252C" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Button x:Name="CollapseBtn" Content="—" FontSize="12"
                        Click="OnCollapseClick" ToolTipService.ToolTip="收起（Esc）"
                        Background="Transparent" BorderThickness="0" CornerRadius="15"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>

            <!-- 退出：独立小圆岛（托盘菜单 P1 前的退出入口） -->
            <Border Grid.Row="0" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,42,0"
                    Background="#B322252C" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Button x:Name="ExitBtn" Click="OnExitClick" ToolTipService.ToolTip="退出灵动岛"
                        Background="Transparent" BorderThickness="0" CornerRadius="15"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Border>

            <!-- 内容岛：整块深色玻璃面板 -->
            <Border Grid.Row="1" CornerRadius="16" Margin="0,8,0,0"
                    Background="#6620242B" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="18">
                <Grid x:Name="ContentHost">

                <!-- P1 工作台：待办岛 + 天气岛（后续组件化进 Widgets/） -->
                <Grid x:Name="Page0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 待办岛 -->
                    <Border Grid.Column="0" CornerRadius="14" Background="#4D22262D"
                            BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="待办" FontSize="14" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,8,0,10" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TodoInput" PlaceholderText="添加一条待办…" FontSize="12"/>
                                <Button Grid.Column="1" Content="添加" Click="OnAddTodoClick"
                                        CornerRadius="6" Padding="14,6" FontSize="12"/>
                            </Grid>
                            <StackPanel x:Name="TodoList" Grid.Row="2" Spacing="8"/>
                        </Grid>
                    </Border>

                    <!-- 天气岛 -->
                    <Border Grid.Column="1" CornerRadius="14" Background="#4D22262D"
                            BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="天气 · 北京" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WeatherNow" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="WeatherDetail" Text="加载中…" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- P2 文件页（左公共 45% / 右个人 55%） -->
                <!-- P2 文件页：左公共（群选择）/右个人，P0 平铺列表 -->
                <Grid x:Name="Page1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 公共文件岛 -->
                    <Border Grid.Column="0" CornerRadius="14" Background="#4D22262D"
                            BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="公共文件" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GroupCombo" Grid.Column="1" FontSize="12" MinWidth="110"
                                          SelectionChanged="OnGroupChanged"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PublicFileList" Spacing="6"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 我的文件岛 -->
                    <Border Grid.Column="1" CornerRadius="14" Background="#4D22262D"
                            BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="我的文件" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="上传" Click="OnUploadClick"
                                        CornerRadius="6" Padding="14,6" FontSize="12"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MyFileList" Spacing="6"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- P3 对话页（左列表 260px / 右会话） -->
                <StackPanel x:Name="Page2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="对话" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="单聊+群聊 · WS 实时推送" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock Text="（服务接入后填充）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- P4 个人中心（左资料 / 右设置） -->
                <StackPanel x:Name="Page3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="36" Opacity="0.6"/>
                    <TextBlock Text="个人中心" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="资料/头像/密码 + 设置中心" Opacity="0.55" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MeWelcome" Text="（未登录）" Opacity="0.75" FontSize="13" HorizontalAlignment="Center"/>
                    <TextBlock Text="（登录卡在无 token 时强制展示，服务接入后实现）" Opacity="0.35" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 登录卡（无 token 时强制展开；docs/02 §四） ================= -->
        <Grid x:Name="LoginPanel" Visibility="Collapsed">
            <Border Width="300" Padding="28,24" CornerRadius="20"
                    Background="#F014171C" BorderBrush="#22FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="{ThemeResource IslandAccentBrush}"/>
                    <TextBlock Text="IF-OA 灵动岛" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" Margin="0,-2,0,0"/>
                    <TextBlock Text="登录以连接办公服务" FontSize="12" Opacity="0.55"/>

                    <TextBlock Text="用户名" FontSize="12" Opacity="0.7" Margin="0,8,0,0"/>
                    <TextBox x:Name="LoginUser" PlaceholderText="admin"/>
                    <TextBlock Text="密码" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                    <PasswordBox x:Name="LoginPass"/>
                    <TextBlock Text="服务器" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBox x:Name="LoginServer" FontSize="12"/>

                    <TextBlock x:Name="LoginError" Text="" FontSize="12"
                               Foreground="{ThemeResource IslandDangerBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="LoginBtn" Content="登录" Click="OnLoginClick"
                            HorizontalAlignment="Stretch" CornerRadius="8"
                            Background="{ThemeResource IslandAccentBrush}" Foreground="White"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
