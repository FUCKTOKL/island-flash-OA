<?xml version="1.0" encoding="utf-8"?>
<!-- 灵动岛壳窗口：布局规格取自 docs/02-灵动岛设计.md v1.0
     胶囊态 216×36（时间·正在播放·未读角标）↔ 展开态 1280×480（44px 页签栏 + 页面区） -->
<Window
    x:Class="IslandApp.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource RootBg}"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased">

        <!-- 刘海框：DWM 硬件 AA 圆角（窗口上推 EDGE_PUSH 遮顶弧=顶边直角）；
             内容下移 9 与窗口上推量对齐；内层 6px 小圆角贴 DWM 8px 外弧 -->
        <Border x:Name="IslandFrame" CornerRadius="0,0,6,6"
                BorderBrush="{ThemeResource FrameEdge}" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource IslandTopColor}" Offset="0"/>
                    <GradientStop Color="{ThemeResource IslandBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>

            <!-- 翡翠光晕（Ethereal Glass）：顶部中心向外扩散；主题令牌控强度，不挡交互 -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.75" RadiusY="1.4">
                        <GradientStop Color="{ThemeResource GlowColor}" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="0,9,0,0">

        <!-- ================= 胶囊态（216×36） ================= -->
        <!-- 胶囊态：极简把手（拍板：收起只留“-”）；未读时叠红点 -->
        <Grid x:Name="CapsulePanel" Height="36">
            <!-- 胶囊活内容（DeskBox 哲学：胶囊=活的入口）：无待办时回落为把手 -->
            <Border x:Name="CapDash" Width="36" Height="4" CornerRadius="2" Background="{ThemeResource DashBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="CapTodo" Text="" FontSize="11" Opacity="0.9" VerticalAlignment="Center"
                       Margin="14,0,0,0" MaxWidth="128" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <Border x:Name="Badge" CornerRadius="8" Background="{ThemeResource IslandDangerBrush}"
                    MinWidth="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top"
                    HorizontalAlignment="Right" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Text="0" FontSize="10" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ================= 展开态（1280×480） ================= -->
        <Grid x:Name="ExpandedPanel" Visibility="Collapsed" IsHitTestVisible="False" Padding="16,8,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 天平账结构：支点梁（横线+中央枢轴点）+ 账页签行 + 右侧控制圆岛 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid Height="9">
                    <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource FrameEdge}"/>
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource IslandAccentBrush}" HorizontalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Tab0" Tag="0" Click="OnTabClick" ToolTipService.ToolTip="工作台"
                                Background="{ThemeResource ChipBg}" BorderThickness="0" CornerRadius="6" Padding="14,5">
                            <StackPanel>
                                <TextBlock Text="工作台" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="WORKBENCH" FontSize="7" FontFamily="Cascadia Mono" CharacterSpacing="80" Opacity="0.55"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="Tab1" Tag="1" Click="OnTabClick" ToolTipService.ToolTip="文件"
                                Background="{ThemeResource ChipBg}" BorderThickness="0" CornerRadius="6" Padding="14,5">
                            <StackPanel>
                                <TextBlock Text="文件" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="FILES" FontSize="7" FontFamily="Cascadia Mono" CharacterSpacing="80" Opacity="0.55"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="Tab2" Tag="2" Click="OnTabClick" ToolTipService.ToolTip="对话"
                                Background="{ThemeResource ChipBg}" BorderThickness="0" CornerRadius="6" Padding="14,5">
                            <StackPanel>
                                <TextBlock Text="对话" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="CHAT" FontSize="7" FontFamily="Cascadia Mono" CharacterSpacing="80" Opacity="0.55"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="Tab3" Tag="3" Click="OnTabClick" ToolTipService.ToolTip="个人中心"
                                Background="{ThemeResource ChipBg}" BorderThickness="0" CornerRadius="6" Padding="14,5">
                            <StackPanel>
                                <TextBlock Text="个人中心" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="ME" FontSize="7" FontFamily="Cascadia Mono" CharacterSpacing="80" Opacity="0.55"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{ThemeResource ChipBg}" BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1">
                            <Button x:Name="ThemeBtn" Click="OnThemeToggleClick" ToolTipService.ToolTip="切换深浅主题"
                                    Background="Transparent" BorderThickness="0" CornerRadius="17"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="16" FontFamily="Segoe Fluent Icons"/>
                            </Button>
                        </Border>
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{ThemeResource ChipBg}" BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1">
                            <Button x:Name="ExitBtn" Click="OnExitClick" ToolTipService.ToolTip="退出灵动岛"
                                    Background="Transparent" BorderThickness="0" CornerRadius="17"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <FontIcon Glyph="&#xE711;" FontSize="15" FontFamily="Segoe Fluent Icons"/>
                            </Button>
                        </Border>
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{ThemeResource ChipBg}" BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1">
                            <Button x:Name="CollapseBtn" Content="—" FontSize="16" FontWeight="SemiBold"
                                    Click="OnCollapseClick" ToolTipService.ToolTip="收起（Esc）"
                                    Background="Transparent" BorderThickness="0" CornerRadius="17"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 翼区：浮片直接坐在岛玻璃上（天平账语言）；容器保留作入场合成动画锚点 -->
            <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                <Grid x:Name="ContentHost">

<!-- Page0 工作台（天平账）：左=待办+客户端快捷方式 / 中=天气柱 / 右=审批hero+音乐 -->
                <Grid x:Name="Page0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 待办浮片 -->
                        <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="待办" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TodoList" Spacing="8"/>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TodoInput" PlaceholderText="添加待办…" FontSize="12"/>
                                    <Button Grid.Column="1" Content="添加" Click="OnAddTodoClick"
                                            CornerRadius="8" Padding="16,7" FontSize="12"
                                            Background="{ThemeResource IslandAccentBrush}" Foreground="White"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- 客户端快捷方式（P2 接入启动器，现为占位） -->
                        <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="客户端快捷方式" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                    <TextBlock Text="APPS" FontSize="9" FontFamily="Cascadia Mono" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnSpacing="8" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" ToolTipService.ToolTip="待 P2 接入启动器">
                                        <Border CornerRadius="8" Background="{ThemeResource IslandAccentBrush}" Height="40">
                                            <TextBlock Text="企微" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="企业微信" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" ToolTipService.ToolTip="待 P2 接入启动器">
                                        <Border CornerRadius="8" Background="{ThemeResource IslandDangerBrush}" Height="40">
                                            <TextBlock Text="邮箱" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Outlook" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" ToolTipService.ToolTip="待 P2 接入启动器">
                                        <Border CornerRadius="8" Background="#7FA8D9" Height="40">
                                            <TextBlock Text="表格" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Excel" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" ToolTipService.ToolTip="待 P2 接入启动器">
                                        <Border CornerRadius="8" Background="{ThemeResource ApprBg}" Height="40">
                                            <TextBlock Text="代码" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="VS Code" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 天气柱（中央支点） -->
                    <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="18">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="天气 · 北京" FontSize="13" Opacity="0.6" FontFamily="Segoe UI Variable Display" CharacterSpacing="60" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="WeatherNow" Text="—" FontSize="44" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock x:Name="WeatherDetail" Text="加载中…" Opacity="0.7" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 右翼：审批 hero + 音乐占位（SMTC P2） -->
                    <Grid Grid.Column="2" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="8"
                                Background="{ThemeResource ApprBg}" BorderBrush="{ThemeResource ApprBorder}" BorderThickness="1" Padding="16,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="审批" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ApprFg}" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                    <TextBlock Text="APPROVALS" FontSize="9" FontFamily="Cascadia Mono" Foreground="{ThemeResource ApprSub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ApprCount" Text="0" FontSize="40" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ApprNum}" FontFamily="Segoe UI Variable Display" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ApprSub" Grid.Column="1" Text="加载中…" FontSize="11" Opacity="0.75"
                                               Foreground="{ThemeResource ApprFg}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                                <Button Content="进入审批 ›" Click="OnOpenApprovalsClick" CornerRadius="6"
                                        BorderBrush="{ThemeResource ApprFg}" BorderThickness="1" Padding="14,5"
                                        Background="Transparent" Foreground="{ThemeResource ApprFg}" FontSize="11"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="音乐 · 正在播放" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                    <TextBlock Text="SMTC" FontSize="9" FontFamily="Cascadia Mono" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Ellipse Width="46" Height="46" Stroke="{ThemeResource CardBorder}" StrokeThickness="8"
                                             Fill="{ThemeResource ContentBg}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="待接入系统媒体" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="SMTC · 不做播放器（P2）" FontSize="10" Opacity="0.55"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- P2 文件页（左公共 45% / 右个人 55%） -->
                <!-- P2 文件页：左公共（群选择）/右个人，P0 平铺列表 -->
                <Grid x:Name="Page1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 公共文件岛：标题左上 / 列表中 / 群选择器下沉底部操作条 -->
                    <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="公共文件" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PublicFileList" Spacing="6"/>
                            </ScrollViewer>
                            <ComboBox x:Name="GroupCombo" Grid.Row="2" FontSize="12" Margin="0,10,0,0"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnGroupChanged"/>
                        </Grid>
                    </Border>

                    <!-- 我的文件岛：上传按钮下沉底部操作条 -->
                    <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="我的文件" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MyFileList" Spacing="6"/>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="上传文件到我的空间" Click="OnUploadClick"
                                    CornerRadius="8" Padding="16,8" FontSize="12" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" Background="{ThemeResource IslandAccentBrush}" Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- P3 对话页：左会话列表 / 右消息气泡，WS 实时 -->
                <Grid x:Name="Page2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 会话列表岛 -->
                    <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ConvList" Spacing="4"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 会话岛 -->
                    <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ChatTitle" Text="选择左侧会话" FontSize="14"
                                       FontFamily="Segoe UI Variable Display" CharacterSpacing="40"
                                       FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MsgList" Spacing="6"/>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MsgInput" PlaceholderText="发消息…（Enter 发送）" FontSize="12"
                                         KeyDown="OnMsgKey"/>
                                <Button Grid.Column="1" Content="发送" Click="OnSendClick" FontSize="12"
                                        CornerRadius="8" Padding="16,7"
                                        Background="{ThemeResource IslandAccentBrush}" Foreground="White"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- P3 个人中心（天平账）：左资料+密码 / 中名片 / 右设置 -->
                <Grid x:Name="Page3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Border CornerRadius="8" Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="个人资料" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                <TextBlock x:Name="ProfName" Text="—" FontSize="13"/>
                                <TextBlock x:Name="ProfRole" Text="—" FontSize="12" Opacity="0.65"/>
                                <TextBlock x:Name="ProfUid" Text="—" FontSize="11" Opacity="0.45" FontFamily="Cascadia Mono"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="修改密码" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                                <PasswordBox x:Name="PwOld" Header="原密码"/>
                                <PasswordBox x:Name="PwNew" Header="新密码"/>
                                <Button Content="修改密码" Click="OnChangePasswordClick" CornerRadius="8" Padding="16,7" FontSize="12"
                                        Background="{ThemeResource IslandAccentBrush}" Foreground="White"/>
                                <TextBlock x:Name="PwNote" Text="" FontSize="11" Opacity="0.7" Foreground="{ThemeResource CardBorder}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                            <Ellipse Width="64" Height="64" Fill="{ThemeResource IslandAccentBrush}"/>
                            <TextBlock x:Name="AvChar" Text="?" Foreground="White" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,-46,0,18"/>
                            <TextBlock x:Name="MeWelcome" Text="（未登录）" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" HorizontalTextAlignment="Center"/>
                            <TextBlock x:Name="ProfUid2" Text="" FontSize="10" Opacity="0.45" HorizontalAlignment="Center" FontFamily="Cascadia Mono"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                            <TextBox x:Name="ServInput" Header="服务端地址" PlaceholderText="http://192.168.1.20:8000" FontSize="12"/>
                            <ToggleSwitch x:Name="TglAuto" Header="开机自启（注册表偏好，P2 生效）" OnContent="" OffContent="" FontSize="12"/>
                            <ToggleSwitch x:Name="DarkTgl" Header="深色主题" OnContent="" OffContent="" FontSize="12" Toggled="OnDarkTglToggled"/>
                            <Slider x:Name="TintSlider" Header="玻璃浓度（亚克力材质）" Minimum="30" Maximum="90"
                                    StepFrequency="5" Width="230" HorizontalAlignment="Left" ValueChanged="OnTintChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存设置" Click="OnSaveSettingsClick" CornerRadius="8" Padding="16,7" FontSize="12"
                                        Background="{ThemeResource IslandAccentBrush}" Foreground="White"/>
                                <TextBlock x:Name="SetNote" Text="" FontSize="11" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </Border>
        </Grid>

            <!-- 审批中心浮层（天平账：对账单） -->
            <Grid x:Name="ApprovalMask" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                  Background="#8C141820">
                <Border CornerRadius="8" Background="{ThemeResource LoginBg}" BorderBrush="{ThemeResource LoginBorder}"
                        BorderThickness="1" Width="660" MaxHeight="400" Padding="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="审批中心 · 待我审批" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display" CharacterSpacing="40"/>
                            <Button Content="✕" Click="OnCloseApprovalsClick" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" FontSize="12" Padding="6,2"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ApList" Spacing="8"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Text="顺序链：1→2→… 逐级 · 指定人 / 部门领导" FontSize="10" Opacity="0.5" FontFamily="Cascadia Mono"/>
                    </Grid>
                </Border>
            </Grid>

        <!-- ================= 登录卡（无 token 时强制展开；docs/02 §四） ================= -->
        <Grid x:Name="LoginPanel" Visibility="Collapsed">
            <Border Width="300" Padding="28,24" CornerRadius="8"
                    Background="{ThemeResource LoginBg}" BorderBrush="{ThemeResource LoginBorder}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="{ThemeResource IslandAccentBrush}"/>
                    <TextBlock Text="IF-OA 灵动岛" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" CharacterSpacing="60" Margin="0,-2,0,0"/>
                    <TextBlock Text="登录以连接办公服务" FontSize="12" Opacity="0.55"/>

                    <TextBlock Text="用户名" FontSize="12" Opacity="0.7" Margin="0,8,0,0"/>
                    <TextBox x:Name="LoginUser" PlaceholderText="admin"/>
                    <TextBlock Text="密码" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                    <PasswordBox x:Name="LoginPass"/>
                    <TextBlock Text="服务器" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBox x:Name="LoginServer" FontSize="12"/>

                    <TextBlock x:Name="LoginError" Text="" FontSize="12"
                               Foreground="{ThemeResource IslandDangerBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="LoginBtn" Content="登录" Click="OnLoginClick"
                            HorizontalAlignment="Stretch" CornerRadius="8"
                            Background="{ThemeResource IslandAccentBrush}" Foreground="White"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
