<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IslandApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 控件默认样式（必需） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局强调色：翡翠绿（黑白两主题通用）+ 危险红 -->
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#FF35A078" />
            <SolidColorBrush x:Key="IslandDangerBrush" Color="#FFE5484D" />

            <!-- 黑白双主题 · 玻璃拟态版：全部半透明 alpha 层叠在 DesktopAcrylicBackdrop 上，
                 黑岛=墨玻璃(白光晕)，白岛=暖白玻璃；数值=可读性优先(岛体90%/卡片70%) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="IslandTopColor">#E6FAF8F4</Color>
                    <Color x:Key="IslandBottomColor">#E6EFEBE3</Color>
                    <Color x:Key="GlowColor">#12000000</Color>
                    <SolidColorBrush x:Key="RootBg" Color="#CCF6F4EF" />
                    <SolidColorBrush x:Key="CardBg" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#1A000000" />
                    <SolidColorBrush x:Key="ChipBg" Color="#F2F3EDE3" />
                    <SolidColorBrush x:Key="ChipBorder" Color="#26000000" />
                    <SolidColorBrush x:Key="ContentBg" Color="#B3FDFCF8" />
                    <SolidColorBrush x:Key="ContentBorder" Color="#14000000" />
                    <SolidColorBrush x:Key="LoginBg" Color="#B3FFFEFB" />
                    <SolidColorBrush x:Key="LoginBorder" Color="#17000000" />
                    <SolidColorBrush x:Key="DashBrush" Color="#CC26221C" />
                    <SolidColorBrush x:Key="FrameEdge" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="IslandTopColor">#E60B0D12</Color>
                    <Color x:Key="IslandBottomColor">#E612161D</Color>
                    <Color x:Key="GlowColor">#26FFFFFF</Color>
                    <SolidColorBrush x:Key="RootBg" Color="#CC090B0E" />
                    <SolidColorBrush x:Key="CardBg" Color="#D9181E2C" />
                    <SolidColorBrush x:Key="CardBorder" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ChipBg" Color="#E61E2431" />
                    <SolidColorBrush x:Key="ChipBorder" Color="#3AFFFFFF" />
                    <SolidColorBrush x:Key="ContentBg" Color="#B3181D28" />
                    <SolidColorBrush x:Key="ContentBorder" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="LoginBg" Color="#B3131720" />
                    <SolidColorBrush x:Key="LoginBorder" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="DashBrush" Color="#B8F2F5F4" />
                    <SolidColorBrush x:Key="FrameEdge" Color="#1EFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
