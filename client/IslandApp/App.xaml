<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IslandApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 控件默认样式（必需） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局强调色（黑白两主题通用） -->
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#FF35A078" />
            <SolidColorBrush x:Key="IslandDangerBrush" Color="#FFE5484D" />

            <!-- 黑白双主题令牌：切换只翻 Root.RequestedTheme，所有 ThemeResource 自动跟随 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 白岛 -->
                    <Color x:Key="IslandTopColor">#FFFEFEFE</Color>
                    <Color x:Key="IslandBottomColor">#FFF0F2F6</Color>
                    <SolidColorBrush x:Key="RootBg" Color="#FFFDFDFE" />
                    <SolidColorBrush x:Key="CardBg" Color="#FFEFF1F6" />
                    <SolidColorBrush x:Key="CardBorder" Color="#12000000" />
                    <SolidColorBrush x:Key="ChipBg" Color="#FFF4F6F9" />
                    <SolidColorBrush x:Key="ChipBorder" Color="#16000000" />
                    <SolidColorBrush x:Key="ContentBg" Color="#FFF8F9FB" />
                    <SolidColorBrush x:Key="ContentBorder" Color="#16000000" />
                    <SolidColorBrush x:Key="LoginBg" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="LoginBorder" Color="#16000000" />
                    <SolidColorBrush x:Key="DashBrush" Color="#CC1F2329" />
                    <SolidColorBrush x:Key="FrameEdge" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- 黑岛 -->
                    <Color x:Key="IslandTopColor">#FF131519</Color>
                    <Color x:Key="IslandBottomColor">#FF1D2127</Color>
                    <SolidColorBrush x:Key="RootBg" Color="#FF131519" />
                    <SolidColorBrush x:Key="CardBg" Color="#FF22262D" />
                    <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ChipBg" Color="#FF22252C" />
                    <SolidColorBrush x:Key="ChipBorder" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ContentBg" Color="#FF20242B" />
                    <SolidColorBrush x:Key="ContentBorder" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="LoginBg" Color="#FF14171C" />
                    <SolidColorBrush x:Key="LoginBorder" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="DashBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="FrameEdge" Color="#30FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
